# ── Klinq CRM — Environment Variables Template ─────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it's in .gitignore.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ── Postgres / Prisma ─────────────────────────────────────────────────────────
POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
POSTGRES_USER=postgres
POSTGRES_DATABASE=postgres
POSTGRES_PRISMA_URL=postgres://postgres.YOUR_PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.YOUR_PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Email — Gmail SMTP ────────────────────────────────────────────────────────
# Get an App Password at: myaccount.google.com → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Your CRM Name

# ── SMS — Fast2SMS (India) ────────────────────────────────────────────────────
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
FAST2SMS_SENDER_ID=YOUR_SENDER_ID

# ── WhatsApp / Meta Business API ────────────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_SYSTEM_USER_TOKEN=YOUR_META_SYSTEM_USER_TOKEN
# IMPORTANT: This must match exactly what you set in Meta Developer Console → Webhooks → Verify Token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# ── AI — Google Gemini ───────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Payments — Razorpay ──────────────────────────────────────────────────────
# ⚠️  CRITICAL: Use LIVE keys (rzp_live_...) in production, not test keys.
# Get these at: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
# Get this at: dashboard.razorpay.com → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ── Site / App URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Dev Settings ─────────────────────────────────────────────────────────────
# Set to true ONLY in local development to bypass auth for testing
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

NODE_OPTIONS=--dns-result-order=ipv4first
