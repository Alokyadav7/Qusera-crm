# ============================================================
# Qwix CRM — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, NEVER expose to client
# Used for: super admin operations, impersonation, webhooks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Razorpay Payments (required for billing) ─────────────────
# Get keys at: https://razorpay.com/dashboard → Settings → API Keys
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id  # same as RAZORPAY_KEY_ID

# Webhook secret — set in Razorpay Dashboard → Settings → Webhooks
# Add webhook URL: https://yourdomain.com/api/billing/webhook
# Events to enable: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Email — Gmail SMTP ───────────────────────────────────────
# Klinq CRM sends emails FROM: klinqcrm@gmail.com via Gmail SMTP
# Gmail App Password setup (takes 2 minutes):
#   1. Enable 2-Step Verification: myaccount.google.com → Security
#   2. Go to: myaccount.google.com → Security → App Passwords
#   3. Select app: Mail · Device: Other → name it "Klinq CRM"
#   4. Click Generate → copy the 16-character password
GMAIL_USER=klinqcrm@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM_NAME=Klinq CRM



GEMINI_API_KEY=your_gemini_key_here

NEXT_PUBLIC_META_APP_ID=1486897436377787
META_APP_SECRET=41d8ba5df1456948f4853c0cdcd1f525
META_SYSTEM_USER_TOKEN=EAAVIU0mDQrsBRmVZC3YLl0u2tun7Dw0vumZCEfy9ShzhGM8MZCZBQkEfCi5xVbOISk8ocCpEY11jNTalc39M57yX43WxkOXtudaXxXPPIR6JZBB2xJrerkBndIZBMqe8rjeUjrAZBzXKZACMERPdW0PDC4XB5Teh1nw41HxxP6QY9d5VP59MlzCHEA1cDcl75QZDZD
WHATSAPP_VERIFY_TOKEN=kling_crm_webhook_2025


